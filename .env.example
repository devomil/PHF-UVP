# ─────────────────────────────────────────────────────────────────────────────
# Environment variable reference for AI Video Production Studio
# Copy this file to .env and fill in the values you need.
# Lines starting with # are comments.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────

# Required in production — the app throws on startup if missing.
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL used to build OAuth callback URLs when GOOGLE_CALLBACK_URL etc.
# are not set explicitly.
# APP_URL=https://your-app.example.com

# Set to "production" to enable secure cookies, strict trust-proxy, etc.
# NODE_ENV=production

# ── Admin bootstrap ───────────────────────────────────────────────────────────
#
# ADMIN_EMAILS is the ONLY way to create the very first admin account.
# Once that account exists, all further admin promotion / demotion is done
# through the Admin → Users panel — no env-var change or server restart needed.
#
# How it works:
#   • Comma-separated list of email addresses that are automatically promoted
#     to role="admin" the next time they sign in (local or OAuth).
#   • Once the role is persisted in the database, the env var entry is no
#     longer needed for that user — they stay admin even if removed from this
#     list.
#   • Leaving this empty after initial setup is fine; manage admins via the UI.
#
# Example (replace with the real first-admin email):
# ADMIN_EMAILS=firstadmin@example.com
#
# Multiple admins at once:
# ADMIN_EMAILS=alice@example.com,bob@example.com

ADMIN_EMAILS=

# ── Database ──────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── AI / LLM providers ───────────────────────────────────────────────────────

ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-5-20250929)
# ANTHROPIC_LLM_MODEL=

PIAPI_API_KEY=
# Optional LLM model override (default: claude-sonnet-4-6)
# PIAPI_LLM_MODEL=

RECRAFT_API_KEY=
FALAI_API_KEY=

# ── Video generation ──────────────────────────────────────────────────────────

# Remotion Lambda (video composition / rendering)
REMOTION_SERVE_URL=
REMOTION_S3_BUCKET=
REMOTION_AWS_REGION=
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_FUNCTION_NAME=

# ── Voice & audio ─────────────────────────────────────────────────────────────

ELEVENLABS_API_KEY=

# Play.ht — both required to enable the playht voiceover provider
# PLAYHT_API_KEY=
# PLAYHT_USER_ID=

# ── Notifications ────────────────────────────────────────────────────────────

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

ADMIN_NOTIFICATION_EMAIL=
ADMIN_NOTIFICATION_PHONE=

# ── Social & publishing ───────────────────────────────────────────────────────

AYRSHARE_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_TRENDS_KEY=

# ── Payments ──────────────────────────────────────────────────────────────────

# Stripe
# STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── OAuth social login ────────────────────────────────────────────────────────

# Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=   # default: ${APP_URL}/api/auth/google/callback

# Facebook
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_CALLBACK_URL= # default: ${APP_URL}/api/auth/facebook/callback

# Apple (Sign in with Apple)
# APPLE_CLIENT_ID=       # Services ID, e.g. com.example.signin
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=     # Full .p8 PEM — literal \n sequences are auto-restored

# Set to "1" to advertise all OAuth providers in the UI without real credentials
# (UI preview only — sign-in flows won't work)
# OAUTH_PREVIEW_MODE=0

# ── Canva integration ─────────────────────────────────────────────────────────

CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=

# Exploratory flag — surfaces canva:true on /api/auth/providers
# ENABLE_CANVA_LOGIN=0

# ── Runway video ──────────────────────────────────────────────────────────────

# RUNWAY_API_KEY=
# RUNWAY_ALLOWED_MODELS=runway-gen4-aleph,runway-aleph-2
# RUNWAY_DISABLED=0     # Set to 1/true/yes to block ALL Runway calls
